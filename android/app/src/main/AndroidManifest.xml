<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Runtime-requested (FirebaseMessaging.requestPermission()) on Android
         13+ for push notifications — see lib/services/push_notification_service.dart. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="count_me_in"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-7276238684080299~9530275158"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Custom-scheme deep links (e.g. countmein://join/group/ABC123)
                 for invite links — see lib/services/deep_link_service.dart.
                 Kept as a fallback alongside the real App Links below. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="countmein"/>
            </intent-filter>
            <!-- Real App Links, verified via assetlinks.json hosted at
                 https://count-me-in-links.pages.dev/.well-known/assetlinks.json
                 (Cloudflare Pages, not the app's own molten-mage.github.io site —
                 GitHub Pages can't serve a custom Content-Type for an
                 extension-less file, which apple-app-site-association requires
                 to be application/json; Cloudflare Pages' _headers file can) —
                 lets invite links open the app directly without needing the
                 countmein:// scheme, and falls back to the landing page at
                 that URL if the app isn't installed. NOTE: assetlinks.json
                 currently declares package_name "com.example.count_me_in"
                 (the applicationId below) — update it there if that ever
                 changes. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="count-me-in-links.pages.dev"
                    android:pathPrefix="/join"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
