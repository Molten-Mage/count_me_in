rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Challenge objective ids are always 'obj_0'..'obj_9' (assigned by
    // index at creation, capped at maxChallengeObjectives in
    // lib/models/challenge.dart) — enumerable, so per-value bounds can be
    // checked without a loop (Firestore rules has no loop construct).
    function challengeObjectiveIds() {
      return ['obj_0', 'obj_1', 'obj_2', 'obj_3', 'obj_4', 'obj_5', 'obj_6', 'obj_7', 'obj_8', 'obj_9'];
    }

    function challengeTallyValueValid(tallies, key) {
      return !(key in tallies)
        || (tallies[key] is int && tallies[key] >= 0 && tallies[key] <= 999999);
    }

    // Every key must be a known objective id, and every present value must
    // be a non-negative int within a sane bound.
    function challengeTalliesValid(tallies) {
      return tallies.keys().hasOnly(challengeObjectiveIds())
        && challengeTallyValueValid(tallies, 'obj_0')
        && challengeTallyValueValid(tallies, 'obj_1')
        && challengeTallyValueValid(tallies, 'obj_2')
        && challengeTallyValueValid(tallies, 'obj_3')
        && challengeTallyValueValid(tallies, 'obj_4')
        && challengeTallyValueValid(tallies, 'obj_5')
        && challengeTallyValueValid(tallies, 'obj_6')
        && challengeTallyValueValid(tallies, 'obj_7')
        && challengeTallyValueValid(tallies, 'obj_8')
        && challengeTallyValueValid(tallies, 'obj_9');
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy;
      // Anyone signed in can join (adds only their own uid to memberIds).
      // Any current member can leave on their own (memberIds shrinks by
      // exactly their own uid) — used for account deletion too. Only the
      // creator can remove OTHER members, or edit the group's name/target.
      // Any current member can award a badge (badges-only change) when
      // their increment crosses the group's goal.
      allow update: if request.auth != null
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.removeAll([request.auth.uid])
              == resource.data.memberIds
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && resource.data.memberIds.removeAll([request.auth.uid])
              == request.resource.data.memberIds
          )
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.memberIds.size() < resource.data.memberIds.size()
          )
          // The creator leaving hands admin to one of the remaining
          // members in the same update (memberIds shrinks by exactly the
          // creator's own uid, and the new createdBy must be one of the
          // members left in the group).
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'createdBy'])
            && resource.data.memberIds.removeAll([request.auth.uid])
              == request.resource.data.memberIds
            && request.resource.data.createdBy in request.resource.data.memberIds
          )
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'target'])
          )
          || (
            request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badges'])
          )
        );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /members/{memberId} {
        allow read: if request.auth != null;

        // Joining a group is always self-service, and the member doc must
        // start at exactly zero.
        allow create: if request.auth != null
          && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['displayName', 'tally', 'joinedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.tally == 0
          && request.resource.data.joinedAt is timestamp;

        // In a member-controlled group (the default, and legacy groups
        // predating the `adminControlled` field) each member updates their
        // own doc. In an admin-controlled group only the group's creator
        // can update any member's doc, including their own. Only the
        // `tally` field may change via update, and it must stay a
        // non-negative int within a sane bound — previously any value
        // (including negative, or unbounded) was accepted here with no
        // server-side check, relying only on the app's client-side
        // clamping. Keep this bound in sync with `maxCounterInput` in
        // lib/widgets/app_dialog.dart.
        allow update: if request.auth != null
          && (
            (
              request.auth.uid == memberId
              && !get(/databases/$(database)/documents/groups/$(groupId)).data.get('adminControlled', false)
            )
            || request.auth.uid
              == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tally'])
          && request.resource.data.tally is int
          && request.resource.data.tally >= 0
          && request.resource.data.tally <= 999999;

        // Any member can delete their own doc (leaving the group); the
        // group creator can also remove other members' docs.
        allow delete: if request.auth != null
          && (
            request.auth.uid == memberId
            || request.auth.uid
              == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          );
      }
    }

    match /challenges/{challengeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.objectives.size() >= 1
        && request.resource.data.objectives.size() <= 10;
      // Same join/leave/ownership-handoff shape as groups; challenges have
      // no admin-controlled variant, so there's no name-edit clause. The
      // creator can adjust objective targets (count stays within bounds;
      // name/id integrity for individual objectives isn't validated
      // server-side, same light-touch level as other non-tally fields).
      allow update: if request.auth != null
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.removeAll([request.auth.uid])
              == resource.data.memberIds
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && resource.data.memberIds.removeAll([request.auth.uid])
              == request.resource.data.memberIds
          )
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'createdBy'])
            && resource.data.memberIds.removeAll([request.auth.uid])
              == request.resource.data.memberIds
            && request.resource.data.createdBy in request.resource.data.memberIds
          )
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['objectives'])
            && request.resource.data.objectives.size() >= 1
            && request.resource.data.objectives.size() <= 10
          )
        );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /participants/{uid} {
        allow read: if request.auth != null;

        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['displayName', 'tallies', 'joinedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.tallies == {}
          && request.resource.data.joinedAt is timestamp;

        // Self-service only (no admin-controlled variant), only `tallies`
        // (bounded) and `completedAt` (set/cleared alongside it, as the
        // client crosses/un-crosses "every targeted objective reached")
        // may change, and no more updates once the challenge's deadline
        // (if any) has passed.
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tallies', 'completedAt'])
          && challengeTalliesValid(request.resource.data.tallies)
          && (
            !('completedAt' in request.resource.data)
            || request.resource.data.completedAt == null
            || request.resource.data.completedAt is timestamp
          )
          && (
            get(/databases/$(database)/documents/challenges/$(challengeId)).data.endsAt == null
            || request.time < get(/databases/$(database)/documents/challenges/$(challengeId)).data.endsAt
          );

        allow delete: if request.auth != null
          && (
            request.auth.uid == uid
            || request.auth.uid
              == get(/databases/$(database)/documents/challenges/$(challengeId)).data.createdBy
          );
      }
    }
  }
}
