rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.createdBy;
      // Anyone signed in can join (adds only their own uid to memberIds).
      // Any current member can leave on their own (memberIds shrinks by
      // exactly their own uid) — used for account deletion too. Only the
      // creator can remove OTHER members, or edit the group's name/target.
      // Any current member can award a badge (badges-only change) when
      // their increment crosses the group's goal.
      allow update: if request.auth != null
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.removeAll([request.auth.uid])
              == resource.data.memberIds
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && resource.data.memberIds.removeAll([request.auth.uid])
              == request.resource.data.memberIds
          )
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.memberIds.size() < resource.data.memberIds.size()
          )
          // The creator leaving hands admin to one of the remaining
          // members in the same update (memberIds shrinks by exactly the
          // creator's own uid, and the new createdBy must be one of the
          // members left in the group).
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'createdBy'])
            && resource.data.memberIds.removeAll([request.auth.uid])
              == request.resource.data.memberIds
            && request.resource.data.createdBy in request.resource.data.memberIds
          )
          || (
            request.auth.uid == resource.data.createdBy
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'target'])
          )
          || (
            request.auth.uid in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['badges'])
          )
        );
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.createdBy;

      match /members/{memberId} {
        allow read: if request.auth != null;

        // Joining a group is always self-service, and the member doc must
        // start at exactly zero.
        allow create: if request.auth != null
          && request.auth.uid == memberId
          && request.resource.data.keys().hasOnly(['displayName', 'tally', 'joinedAt'])
          && request.resource.data.displayName is string
          && request.resource.data.tally == 0
          && request.resource.data.joinedAt is timestamp;

        // In a member-controlled group (the default, and legacy groups
        // predating the `adminControlled` field) each member updates their
        // own doc. In an admin-controlled group only the group's creator
        // can update any member's doc, including their own. Only the
        // `tally` field may change via update, and it must stay a
        // non-negative int within a sane bound — previously any value
        // (including negative, or unbounded) was accepted here with no
        // server-side check, relying only on the app's client-side
        // clamping. Keep this bound in sync with `maxCounterInput` in
        // lib/widgets/app_dialog.dart.
        allow update: if request.auth != null
          && (
            (
              request.auth.uid == memberId
              && !get(/databases/$(database)/documents/groups/$(groupId)).data.get('adminControlled', false)
            )
            || request.auth.uid
              == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tally'])
          && request.resource.data.tally is int
          && request.resource.data.tally >= 0
          && request.resource.data.tally <= 999999;

        // Any member can delete their own doc (leaving the group); the
        // group creator can also remove other members' docs.
        allow delete: if request.auth != null
          && (
            request.auth.uid == memberId
            || request.auth.uid
              == get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy
          );
      }
    }
  }
}
